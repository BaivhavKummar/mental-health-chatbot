import cv2
from deepface import DeepFace
import speech_recognition as sr
import time
import threading # We'll use this later for improvement, import now

print("Libraries imported successfully.")

# --- Configuration ---
# Try different detectors if 'opencv' doesn't work well: 'ssd', 'dlib', 'mtcnn', 'retinaface'
FACE_DETECTOR_BACKEND = 'opencv'
# Set a confidence threshold for emotion display (adjust as needed)
EMOTION_CONFIDENCE_THRESHOLD = 0.6 # e.g., 60% confidence

# --- Initialization ---
print("Initializing components...")

# 1. Initialize Speech Recognition
recognizer = sr.Recognizer()
microphone = sr.Microphone()

# Adjust for ambient noise once at the start
try:
    with microphone as source:
        print("Adjusting for ambient noise... Please be quiet for a moment.")
        recognizer.adjust_for_ambient_noise(source, duration=2)
        print("Ambient noise adjustment complete.")
except Exception as e:
    print(f"Could not access microphone: {e}")
    # Exit or handle error appropriately if microphone is essential

# 2. Initialize Webcam
try:
    cap = cv2.VideoCapture(0) # 0 is usually the default webcam
    if not cap.isOpened():
        raise IOError("Cannot open webcam")
    print("Webcam initialized.")
    # Set frame width and height (optional, can help performance)
    # cap.set(cv2.CAP_PROP_FRAME_WIDTH, 640)
    # cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 480)
except Exception as e:
    print(f"Error initializing webcam: {e}")
    cap = None # Ensure cap is None if initialization failed

# 3. Load DeepFace Model (This might take a few seconds the first time)
# We will call analyze within the loop, pre-loading isn't strictly needed
# but you can pre-build a model if you prefer one specific model:
# try:
#     print("Loading facial emotion model...")
#     emotion_model = DeepFace.build_model("Emotion")
#     print("Facial emotion model loaded.")
# except Exception as e:
#     print(f"Could not load DeepFace model: {e}")
#     emotion_model = None # Handle case where model fails to load


# --- Global variable for transcription ---
transcribed_text = ""
is_listening = False # Flag to indicate listening state

# --- Main Loop ---
print("\nStarting main loop...")
print("Press 'L' in the OpenCV window to start listening.")
print("Press 'Q' in the OpenCV window to quit.")

if cap is not None: # Only run if webcam initialized
    while True:
        ret, frame = cap.read()
        if not ret:
            print("Failed to grab frame, exiting.")
            break

        # --- Facial Emotion Recognition ---
        current_emotion = "No face detected"
        try:
            # Analyze frame for emotion using DeepFace
            # 'enforce_detection=False' prevents errors if no face is found by DeepFace itself
            # Use a specific detector backend for potentially better performance/accuracy
            analysis = DeepFace.analyze(frame,
                                        actions=['emotion'],
                                        detector_backend=FACE_DETECTOR_BACKEND,
                                        enforce_detection=False,
                                        silent=True) # Silent=True prevents progress bars

            # DeepFace returns a list of faces. Use the first one found.
            if isinstance(analysis, list) and len(analysis) > 0:
                 face_data = analysis[0]
                 # Check confidence (Optional but Recommended)
                 # Note: DeepFace analyze doesn't directly expose overall confidence easily,
                 # but you can sometimes check the score for the dominant emotion within face_data['emotion']
                 # This part might need adjustment depending on DeepFace version and output structure
                 dominant_emotion = face_data['dominant_emotion']
                 # emotion_score = face_data['emotion'][dominant_emotion] # Example access

                 # Display only if reasonably confident (you might need to tune threshold/logic)
                 # if emotion_score > EMOTION_CONFIDENCE_THRESHOLD:
                 #     current_emotion = f"{dominant_emotion} ({emotion_score:.2f})"
                 # else:
                 #     current_emotion = "Face detected" # Show detected, but not confident emotion

                 # Simplified version: just show dominant emotion regardless of score for now
                 current_emotion = face_data['dominant_emotion']

                 # Get face bounding box
                 x, y, w, h = face_data['region']['x'], face_data['region']['y'], face_data['region']['w'], face_data['region']['h']

                 # Draw rectangle around the face
                 cv2.rectangle(frame, (x, y), (x+w, y+h), (0, 255, 0), 2)

                 # Put emotion text above the rectangle
                 cv2.putText(frame, current_emotion, (x, y-10), cv2.FONT_HERSHEY_SIMPLEX, 0.9, (0, 255, 0), 2)

            #else: current_emotion remains "No face detected" or handle differently

        except Exception as e:
            # Handle case where DeepFace fails (e.g., model issues, rare errors)
            # Keep `current_emotion` as "No face detected" or set to "Analysis Error"
            # print(f"DeepFace Error: {e}") # Optional debug print
            pass # Continue even if analysis fails for a frame

        # --- Display Status (Listening or Not) ---
        status_text = "Press L to Listen"
        status_color = (255, 255, 255) # White
        if is_listening:
            status_text = "LISTENING..."
            status_color = (0, 0, 255) # Red

        cv2.putText(frame, status_text, (10, 30), cv2.FONT_HERSHEY_SIMPLEX, 0.7, status_color, 2)
        cv2.putText(frame, "Press Q to Quit", (10, 60), cv2.FONT_HERSHEY_SIMPLEX, 0.7, (255, 255, 255), 2)

        # --- Display the resulting frame ---
        cv2.imshow('Live Emotion Detection (Press L to Listen, Q to Quit)', frame)

        # --- Keyboard Input Handling ---
        key = cv2.waitKey(1) & 0xFF

        # Quit
        if key == ord('q') or key == ord('Q'):
            print("Quit key pressed. Exiting...")
            break

        # Listen
        if key == ord('l') or key == ord('L'):
            if not is_listening: # Only start listening if not already listening
                print("\n'L' key pressed. Start speaking!")
                is_listening = True
                transcribed_text = "" # Clear previous transcription

                # -------- THIS PART WILL BLOCK THE VIDEO --------
                try:
                    with microphone as source:
                         # Listen for the first phrase and extract it
                         audio_data = recognizer.listen(source, phrase_time_limit=5) # Listen for max 5 seconds
                         print("Processing audio...")
                    # Recognize speech using Google Web Speech API
                    text = recognizer.recognize_google(audio_data)
                    transcribed_text = f"You said: {text}"
                    print(transcribed_text) # Print in Jupyter output

                    # --- Basic Chatbot Interaction (Example) ---
                    # Here you would add your chatbot logic based on 'text'
                    if "hello" in text.lower():
                        print("Chatbot: Hello there!")
                    elif "how are you" in text.lower():
                         print(f"Chatbot: I am doing well! I see you seem to be feeling {current_emotion}.")
                    else:
                        print("Chatbot: Thanks for sharing!")
                    # ------------------------------------------

                except sr.WaitTimeoutError:
                    print("No speech detected within the time limit.")
                    transcribed_text = "Error: No speech detected."
                except sr.UnknownValueError:
                    print("Google Speech Recognition could not understand audio.")
                    transcribed_text = "Error: Could not understand audio."
                except sr.RequestError as e:
                    print(f"Could not request results from Google Speech Recognition service; {e}")
                    transcribed_text = f"Error: API request failed ({e})."
                except Exception as e_rec:
                    print(f"An unexpected error occurred during recognition: {e_rec}")
                    transcribed_text = f"Error: Recognition failed ({e_rec})."
                finally:
                     is_listening = False # Reset listening flag
                # -------- END OF BLOCKING PART --------

# --- Cleanup ---
print("Releasing resources...")
if cap is not None:
    cap.release()
cv2.destroyAllWindows()
# It's good practice to also call this a few times in case windows don't close immediately
for i in range(5):
    cv2.waitKey(1)

print("\n--- Program Finished ---")
if transcribed_text:
     print(f"Last Transcription: {transcribed_text}")






